/* =========================
   Global
   ========================= */

QMainWindow,
QWidget {
    background-color: #F8FAFC;
    color: #0F172A;
    font-size: 14px;
    font-family: "Segoe UI";
}

/* =========================
   GroupBox
   ========================= */

QGroupBox {
    background-color: white;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    margin-top: 12px;
    padding: 12px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

/* =========================
   Button
   ========================= */

QPushButton {

    background-color: #3B82F6;
    color: white;

    border: none;
    border-radius: 10px;

    padding: 8px 16px;

    font-weight: bold;
}

QPushButton:hover {
    background-color: #2563EB;
}

QPushButton:pressed {
    background-color: #1D4ED8;
}

/* =========================
   LineEdit
   ========================= */

QLineEdit {

    background-color: white;

    border: 1px solid #CBD5E1;

    border-radius: 10px;

    padding: 8px;
}

QLineEdit:focus {

    border: 2px solid #3B82F6;
}

/* =========================
   ComboBox
   ========================= */

QComboBox {

    background-color: white;

    border: 1px solid #CBD5E1;

    border-radius: 10px;

    padding: 6px;
}

QComboBox:hover {
    border: 1px solid #3B82F6;
}

/* =========================
   TreeWidget
   ========================= */

QTreeWidget {

    background-color: white;

    border: 1px solid #E2E8F0;

    border-radius: 12px;

    padding: 6px;
}

QTreeWidget::item {

    padding: 6px;
}

QTreeWidget::item:selected {

    background-color: #DBEAFE;

    color: #1E40AF;

    border-radius: 6px;
}

/* =========================
   TableWidget
   ========================= */

QTableWidget {

    background-color: white;

    border: 1px solid #E2E8F0;

    border-radius: 12px;

    gridline-color: #E2E8F0;
}

QHeaderView::section {

    background-color: #F1F5F9;

    border: none;

    padding: 8px;

    font-weight: bold;
}

/* =========================
   TextEdit
   ========================= */

QTextEdit {

    background-color: white;

    border: 1px solid #E2E8F0;

    border-radius: 12px;

    padding: 10px;
}

/* =========================
   Tabs
   ========================= */

QTabWidget::pane {

    border: none;
}

QTabBar::tab {

    background: white;

    border: 1px solid #E2E8F0;

    border-top-left-radius: 10px;
    border-top-right-radius: 10px;

    padding: 8px 16px;

    margin-right: 4px;
}

QTabBar::tab:selected {

    background: #3B82F6;

    color: white;
}

/* =========================
   RadioButton
   ========================= */

QRadioButton {

    spacing: 8px;
}

/* =========================
   card
   ========================= */

#card {
    background: white;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
}